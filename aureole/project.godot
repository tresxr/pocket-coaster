; Aureole — a small world, a long way from home.
config_version=5

[application]
config/name="Aureole"
config/description="An intimate, living world of tides, dunes and forgotten machines."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.025, 0.023, 0.044, 1)

[display]
window/size/viewport_width=1440
window/size/viewport_height=1080
window/size/window_width_override=1200
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.017, 0.013, 0.035, 1)
mesh_lod/lod_change/threshold_pixels=1.5

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[audio]
driver/enable_input=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[editor_plugins]
enabled=PackedStringArray()
